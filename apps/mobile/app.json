{
  "expo": {
    "name": "LineSkip",
    "slug": "lineskip",
    "scheme": "lineskip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0e0e12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.lineskip.madrid",
      "infoPlist": {
        "NSCameraUsageDescription": "LineSkip usa la cámara para canjear el QR en la puerta.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.lineskip.madrid",
      "permissions": ["CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-camera",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.app.lineskip.madrid",
          "enableGooglePay": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
