# Postgres (docker compose defaults)
DATABASE_URL="postgresql://lineskip:lineskip@localhost:5432/lineskip?schema=public"

# Next.js
PORT=8000
NEXT_PUBLIC_APP_URL="http://localhost:8000"
BETTER_AUTH_URL="http://localhost:8000"
BETTER_AUTH_SECRET="replace-with-32-plus-chars-of-random"

# Stripe (test mode). Use PAYMENTS_MODE=fake to buy without a Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYMENTS_MODE="fake"
APPLICATION_FEE_BPS="1000"
RESERVATION_TTL_MINUTES="15"

# Mobile
EXPO_PUBLIC_API_URL="http://localhost:8000"
